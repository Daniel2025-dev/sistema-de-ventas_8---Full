# Supabase Auth y API (la clave publicable puede estar en el cliente).
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR

# Solo servidor. Nunca publicar ni incluir dentro de una APK.
SUPABASE_SECRET_KEY=sb_secret_REEMPLAZAR

# Conexión PostgreSQL del pooler de Supabase. Use sslmode=require.
DATABASE_URL=postgresql://pos_app_login.TU-PROYECTO:CLAVE@HOST-POOLER:6543/postgres?sslmode=require
DATABASE_POOL_SIZE=8

# "local" muestra el enlace sin enviar correos. Cambiar a "supabase" tras
# configurar redirects y plantilla de invitación en Supabase Auth.
INVITE_DELIVERY_MODE=local

# Configuración del servidor web.
FLET_HOST=0.0.0.0
FLET_PORT=8000
# URL pública usada por los enlaces de recuperación de contraseña. En Render
# se detecta automáticamente desde RENDER_EXTERNAL_URL.
PUBLIC_APP_URL=https://TU-SERVICIO.onrender.com
